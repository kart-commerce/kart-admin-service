<Project>
  <Import Project="../Directory.Build.props" />
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test doubles/fixtures legitimately hit patterns (nullable warnings on mocked members,
         intentionally-unused parameters) that aren't worth elevating to build-breaking here. -->
    <WarningsAsErrors></WarningsAsErrors>
  </PropertyGroup>
</Project>
